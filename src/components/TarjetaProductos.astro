    <div>
      <p>Shampoo Antigrasa</p>
      <h3>{titulo}</h3>
      <p>{parrafo}</p>
    </div>
    <div>
      <p>precio: $15.000</p>
    </div>
    <div>
      <button> comprar </button>
    </div>
  </div>
</section>
