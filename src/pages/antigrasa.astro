<div class="pedropablo">
  <img src="/olé antigrasa.jpeg" alt="" />
</div>










</Layout>


<style>

  .pedropablo {
    display: flex;
    justify-content: center;
  }


  img {
    width: 25%;
    height: auto;
  }
</style>
