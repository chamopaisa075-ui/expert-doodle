---
import PerfumesCap from "../components/PerfumesCap.astro";
import TarjetaProductos from "../components/TarjetaProductos.astro";
import Layout from "../layouts/Layout.astro";

const listaDeproductos=[
    {
        titulo: 'Perfume capilar de chocolate',
        descripcion: 'cholocalate',
        precio:'15'
    },{
        titulo: 'Perfume capilar de galleta',
        descripcion:'galleta',
        precio:'15',
    },{
         titulo: 'perfume capilar de frutas',
        descripcion:'frutas',
        precio:'15',

    },{
         titulo: 'perfue capilar de coco',
        descripcion:'coco',
        precio:'15',
    }
]
---

<Layout>
    <h1 class="day">Perfumes capilares</h1>
    <p class="gloriannys">
        Finalizadores, justo lo que necesitas para verte (y sentirte) wow!
    </p>
    <p class="sara">
        <p>
            Los finalizadores son ese último paso que lo cambia todo. Ayudan a
            definir, controlar y darle el toque final a tu look, sin esfuerzo y
            sin peso. Úsalos a tu manera y deja que tu cabello haga lo suyo.
        </p>

        <div>
            {listaDeproductos.map(function(producto){

                return <PerfumesCap
                titulo={producto.titulo}
                descripcion={producto.descripcion}
                precio={producto.precio}
                
                >



                </PerfumesCap>




            }        
        )}
        </div>
    </p>
</Layout>

<style>
    .day {
        text-align: center;
        font-size: 40px;
        padding: 40px 20px;
        background-color: rgb(155, 90, 215);
    }
    .gloriannys {
        text-align: left;
        font-size: 20px;
    }
    .sara {
        text-align: left;
        font-size: 20px;
    }
</style>
