---
import Layout from "../layouts/Layout.astro";
import TarjetaProductos from "../components/TarjetaProductos.astro";
---

<Layout>
  <h1 class="petra">Shampoo</h1>
  <p class="fred">Tu favorito siempre</p>
  <p class="aleja">
    La historia de tu cabello comienza desde su raíz. El shampoo es el encargado
    de limpiarla, cuidarla y nutrirla. Úsalo diariamente sin miedo y disfruta de
    su textura.
    <div class="juana">
      <TarjetaProductos titulo="Shampoo antigrasa" imagen="shampo 2.jpeg"  />
      <TarjetaProductos titulo="Shampoo mixto" imagen="shampoodecrecimiento.jpeg"/>
      <TarjetaProductos titulo="Shampoo hidratante" imagen="shampohidratante.jpeg" />
      <TarjetaProductos titulo="Shampoo crecimiento" imagen="shampo 3.jpeg" />
    </div>
  </p>
</Layout>
<style>

  .petra {
    text-align: center;
    padding: 20px 10px;
    background-color: rgb(155, 90, 215);
    font-size: 50px;
    text-decoration: none;
    color: rgb(255, 255, 255);
    font-family: 'Times New Roman', Times, serif;
  }
  .fred {
    text-align: left;
    font-size: 100px;
    text-align: center;
    font-family: 'Times New Roman', Times, serif;
  }
  .aleja {
    text-align: center;
    font-size: 50px;
    font-family: 'Times New Roman', Times, serif;
  }
  
  
</style>
