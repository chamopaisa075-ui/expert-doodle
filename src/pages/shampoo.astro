---
import Layout from "../layouts/Layout.astro";
import TarjetaProductos from "../components/TarjetaProductos.astro";
---

<Layout>
  <h1>Shampoo</h1>
  <p>El shampoo</p>
  <div>
    <TarjetaProductos titulo="pulpa de coco" />
    <TarjetaProductos titulo="acondicionador" />
    <TarjetaProductos titulo="proteccion termica" />
    <TarjetaProductos tutilo="aceite de coco" />
  </div>

  <div class="pedropablo">
    <img src="/olé antigrasa.jpeg" alt="" />
  </div>
</Layout>

<style>
  .pedropablo {
    display: flex;
    justify-content: center;
  }

  img {
    width: 25%;
    height: auto;
  }
</style>
